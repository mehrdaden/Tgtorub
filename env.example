# --- required -------------------------------------------------------------
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # from @BotFather
API_ID=1234567                                            # from my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef                 # from my.telegram.org
ADMIN_IDS=111111111                                       # your numeric Telegram id(s), comma separated

# --- optional (defaults shown) ---------------------------------------------
WORK_DIR=/opt/tg2rub/work
MAX_FILE_GB=4
RUBIKA_MAX_MB=1900          # bigger files/zips are split automatically into parts of this size
UPLOAD_ATTEMPTS=10          # automatic retries per part (strategy changes along the way)
UPLOAD_MODE=auto            # auto | bin (send as .bin) | zip (send inside a ZIP)
UPLOAD_TIMEOUT_MIN=240      # per attempt
DOWNLOAD_WORKERS=4          # parallel Telegram download streams (1-8)
AUTO_UPLOAD=0               # 1 = start uploading right after the download finishes
AUTO_DELETE=1               # delete from the server after a successful upload
ZIP_LEVEL=0                 # 0 = store only (fastest) .. 9 = max compression
STALE_HOURS=24              # forgotten files are removed after this many hours
